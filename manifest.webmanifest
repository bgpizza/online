{
  "name": "Bake & Grill Pizza",
  "short_name": "Bake & Grill",
  "description": "Fast, accurate delivery location and online ordering for Bake & Grill.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#111111",
  "theme_color": "#e51b23",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "./index.html",
  "lang": "en-IN",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "food",
    "shopping",
    "lifestyle"
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "Browse Menu",
      "short_name": "Menu",
      "description": "Browse the Bake & Grill food menu",
      "url": "./index.html#categories",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Track Order",
      "short_name": "Track",
      "description": "Track your latest Bake & Grill order",
      "url": "./index.html#trackSection",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://www.bakeandgrill.in"
    }
  ]
}
