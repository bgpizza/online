rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The Master account is explicitly allow-listed. A generic email/password
    // Firebase account must never receive administrative access.
    function masterUser() {
      return signedIn()
        && request.auth.uid == 'f1Gx3tPIigZmqM2ImCzqGQN2xuJ3'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function phoneUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'phone'
        && request.auth.token.phone_number is string;
    }

    function phoneOwnsOrder(orderData) {
      return phoneUser()
        && orderData.phone is string
        && request.auth.token.phone_number == '+91' + orderData.phone;
    }

    function ownsOrder(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid;
    }

    match /stock/{itemId} {
      allow read: if true;
      allow write: if masterUser();
    }

    match /customers/{customerId} {
      // Customer profiles include saved addresses and GPS coordinates.
      allow read, create, update, delete: if phoneUser() && request.auth.uid == customerId;
    }

    match /orders/{orderId} {
      // Order creation goes through the validated checkout function.
      allow create: if false;

      allow read: if masterUser()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || phoneOwnsOrder(resource.data);

      allow delete: if masterUser();

      allow update: if masterUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posReceipt'])
        && resource.data.status in ['ACCEPTED', 'PREPARING', 'READY', 'OUT FOR DELIVERY', 'DELIVERED', 'CANCELLED']
        && request.resource.data.posReceipt is map
        && request.resource.data.posReceipt.keys().hasOnly(['state', 'billNumber'])
        && (
          (request.resource.data.posReceipt.state == 'loaded'
            && !('posReceipt' in resource.data)
            && !('billNumber' in request.resource.data.posReceipt)
            && resource.data.status != 'CANCELLED')
          ||
          (request.resource.data.posReceipt.state in ['billed', 'voided']
            && request.resource.data.posReceipt.billNumber is string
            && request.resource.data.posReceipt.billNumber.matches('^[-A-Za-z0-9]{1,40}$')
            && (!('posReceipt' in resource.data)
              || resource.data.posReceipt.state == 'loaded'
              || (request.resource.data.posReceipt.billNumber == resource.data.posReceipt.billNumber
                && (resource.data.posReceipt.state != 'voided' || request.resource.data.posReceipt.state == 'voided'))))
        );


      allow update: if resource.data.status in ['NEW', 'ACCEPTED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correction'])
        && request.resource.data.correction.keys().hasOnly(['note', 'state', 'updatedAt'])
        && request.resource.data.correction.updatedAt == request.time
        && (
          (phoneUser() && resource.data.customerId == request.auth.uid
            && !('correction' in resource.data)
            && request.resource.data.correction.state == 'pending'
            && request.resource.data.correction.note is string
            && request.resource.data.correction.note.size() > 0
            && request.resource.data.correction.note.size() <= 300)
          || (masterUser() && resource.data.correction.state == 'pending'
            && request.resource.data.correction.note == resource.data.correction.note
            && request.resource.data.correction.state in ['acknowledged', 'declined'])
        );

      allow update: if masterUser()
        && resource.data.status == 'NEW'
        && !('phoneReviewStartedAt' in resource.data)
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(2, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneReviewStartedAt'])
        && request.resource.data.phoneReviewStartedAt == request.time;

      allow update: if
        (
          phoneUser()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['NEW', 'ACCEPTED']
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledBy', 'cancelledAt'])
          && request.resource.data.cancelledBy == 'customer'
        )
        ||
        (
          masterUser()
          && request.resource.data.status != 'ACCEPTED'
          && (resource.data.status != 'NEW' || request.resource.data.status in ['NEW', 'CANCELLED'])
          && resource.data.status != 'DELIVERED'
          && resource.data.status != 'CANCELLED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'statusHistory', 'acceptedAt',
            'expectedDeliveryMinutes', 'outForDeliveryAt',
            'estimatedDeliveryMin', 'estimatedDeliveryMax'
          ])
          && request.resource.data.status in [
            'NEW', 'ACCEPTED', 'PREPARING', 'READY',
            'OUT FOR DELIVERY', 'DELIVERED', 'CANCELLED'
          ]
        );
    }

    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create: if phoneUser()
        && request.resource.data.keys().hasOnly(['token', 'orderId', 'customerId', 'createdAt', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.orderId is string
        && request.resource.data.customerId == request.auth.uid
        && ownsOrder(request.resource.data.orderId);
      allow update, delete: if false;
    }

    match /masterPushTokens/{tokenId} {
      allow read: if false;
      allow create, update, delete: if masterUser();
    }

    match /publicStatuses/{orderId} {
      // This is a private tracking document: never expose customer ID,
      // address/GPS links, delivery address, total or other order details.
      allow read: if masterUser()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if
        (
          phoneUser()
          && request.resource.data.keys().hasOnly(['orderId', 'status', 'customerId', 'updatedAt'])
          && request.resource.data.keys().hasAll(['orderId', 'status', 'customerId', 'updatedAt'])
          && request.resource.data.orderId == orderId
          && request.resource.data.status == 'NEW'
          && request.resource.data.customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        )
        ||
        (
          masterUser()
          && request.resource.data.keys().hasOnly([
            'orderId', 'status', 'customerId', 'updatedAt', 'acceptedAt',
            'expectedDeliveryMinutes', 'outForDeliveryAt',
            'estimatedDeliveryMin', 'estimatedDeliveryMax'
          ])
          && request.resource.data.orderId == orderId
          && existsAfter(/databases/$(database)/documents/orders/$(orderId))
          && request.resource.data.customerId == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerId
          && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status
          && request.resource.data.status in [
            'NEW', 'ACCEPTED', 'PREPARING', 'READY',
            'OUT FOR DELIVERY', 'DELIVERED', 'CANCELLED'
          ]
        );

      allow update: if
        (
          phoneUser()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['NEW', 'ACCEPTED']
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.cancelledBy == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'cancelledBy'])
        )
        ||
        (
          masterUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'acceptedAt', 'expectedDeliveryMinutes',
            'outForDeliveryAt', 'estimatedDeliveryMin', 'estimatedDeliveryMax',
            'cancelReason'
          ])
          && request.resource.data.orderId == orderId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status
          && request.resource.data.status in [
            'NEW', 'ACCEPTED', 'PREPARING', 'READY',
            'OUT FOR DELIVERY', 'DELIVERED', 'CANCELLED'
          ]
        );

      allow delete: if masterUser();
    }

    match /menuRollback/{itemId} {
      allow read, write: if masterUser();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if masterUser();
    }

    match /customerReviews/{orderId} {
      allow read, delete: if masterUser();
      allow update: if false;

      allow create: if phoneUser()
        && request.resource.data.keys().hasOnly(['orderId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.keys().hasAll(['orderId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/publicStatuses/$(orderId))
        && get(/databases/$(database)/documents/publicStatuses/$(orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/publicStatuses/$(orderId)).data.status == 'DELIVERED'
        && (
          !exists(/databases/$(database)/documents/settings/reviews)
          || get(/databases/$(database)/documents/settings/reviews).data.feedbackEnabled != false
        );
    }

    match /orderFraudFlags/{phone} {
      allow read, delete: if masterUser();
      allow create, update: if masterUser()
        && phone.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['reason', 'orderId', 'updatedAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 240
        && request.resource.data.orderId is string
        && request.resource.data.updatedAt == request.time;
    }

    match /appInstallations/{installationId} {
      allow read: if masterUser();
      allow create: if installationId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['recordedAt'])
        && request.resource.data.recordedAt == request.time;
      match /customers/{uid} {
        allow create: if phoneUser() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/appInstallations/$(installationId))
          && request.resource.data.keys().hasOnly(['recordedAt'])
          && request.resource.data.recordedAt == request.time;
        allow get: if phoneUser() && request.auth.uid == uid;
      }
    }

    match /coupons/{code} {
      allow read, delete: if masterUser();
      allow create, update: if masterUser()
        && code.matches('^[A-Z0-9][A-Z0-9_-]{2,23}$')
        && request.resource.data.keys().hasOnly(['type', 'value', 'minimum', 'active', 'firstOrderOnly', 'maxRoadKm', 'recipientPhone', 'recipientPhones', 'installedAppOnly', 'oncePerCustomer', 'expiresAt', 'orderScope'])
        && (!('orderScope' in request.resource.data) || request.resource.data.orderScope in ['both', 'delivery', 'takeaway'])
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt == null
          || (request.resource.data.expiresAt is int && request.resource.data.expiresAt >= 0
            && request.resource.data.expiresAt <= 253402300799999))
        && (!('recipientPhones' in request.resource.data) || request.resource.data.recipientPhones == null
          || (request.resource.data.recipientPhones is string
            && request.resource.data.recipientPhones.size() <= 549
            && request.resource.data.recipientPhones.matches('^[0-9]{10}(,[0-9]{10})*$')))
        && (!('installedAppOnly' in request.resource.data) || request.resource.data.installedAppOnly is bool)
        && (!('oncePerCustomer' in request.resource.data) || request.resource.data.oncePerCustomer is bool)
        && (!('recipientPhone' in request.resource.data) || request.resource.data.recipientPhone == null
          || (request.resource.data.recipientPhone is string
            && request.resource.data.recipientPhone.matches('^[0-9]{10}$')))
        && (!('firstOrderOnly' in request.resource.data) || request.resource.data.firstOrderOnly is bool)
        && (!('maxRoadKm' in request.resource.data) || request.resource.data.maxRoadKm == null
          || (request.resource.data.maxRoadKm is number
            && request.resource.data.maxRoadKm > 0 && request.resource.data.maxRoadKm <= 8))
        && request.resource.data.active is bool
        && request.resource.data.minimum is number
        && request.resource.data.minimum >= 0 && request.resource.data.minimum <= 100000
        && request.resource.data.value is number
        && request.resource.data.value > 0
        && ((request.resource.data.type == 'percent' && request.resource.data.value <= 100)
          || (request.resource.data.type == 'fixed' && request.resource.data.value <= 100000));
    }

    match /settings/{settingId} {
      // Only these settings are intentionally customer-facing.
      allow read: if settingId in ['delivery', 'reviews', 'storefront'];
      allow write: if masterUser();
    }
  }
}
