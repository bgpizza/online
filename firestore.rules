rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null
        && request.auth.uid == "f1Gx3tPIigZmqM2ImCzqGQN2xuJ3";
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /stock/{itemId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    // Atomic public order counter. Order 1 has no 20-minute buffer;
    // Order 2+ gets the extra 20-minute buffer.
    match /orderMeta/{docId} {
      allow read: if docId == "global";
      allow create: if docId == "global"
        && request.resource.data.lastOrderNumber == 1;
      allow update: if docId == "global"
        && request.resource.data.lastOrderNumber == resource.data.lastOrderNumber + 1;
      allow delete: if isMaster();
    }

    match /users/{userId} {
      allow read: if isMaster()
        || (request.auth != null && request.auth.uid == userId);
      allow create: if isMaster()
        || (request.auth != null && request.auth.uid == userId);
      allow update: if isMaster()
        || (request.auth != null && request.auth.uid == userId);
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.orderId is string &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.total is number &&
        request.resource.data.orderNumber is number &&
        request.resource.data.estimatedMinutes is number &&
        request.resource.data.status == "NEW";
      allow read: if request.auth != null;
      allow update: if isMaster() ||
        (request.auth != null && resource.data.deliveryBoyId == request.auth.uid);
      allow delete: if isMaster();
    }

    match /publicStatuses/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == "NEW";
      allow update: if isMaster() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryBoyId == request.auth.uid);
      allow delete: if isMaster();
    }

    match /deliveryBoys/{deliveryBoyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isMaster();
    }

    match /deliveryAssignments/{orderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isMaster();
    }

    match /pushTokens/{tokenId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
