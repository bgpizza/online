rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customer website can read stock availability, but only an authenticated
    // Master user can write stock.

    // Delivery-user profiles. The Master account may create/update/delete profiles.
    // A delivery user may read only their own profile.
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid == 'f1Gx3tPIigZmqM2ImCzqGQN2xuJ3'
      );
      allow create, update, delete: if request.auth != null &&
        request.auth.uid == 'f1Gx3tPIigZmqM2ImCzqGQN2xuJ3';
    }

    match /stock/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers can create new orders without signing in.
    // Only authenticated Master users can read/update/delete orders.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.orderId is string &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.total is number &&
        request.resource.data.status == 'NEW';
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.status != 'DELIVERED' &&
        resource.data.status != 'CANCELLED';
    }

    // Public tracking exposes status only. A customer may create the initial
    // NEW status record when placing an order; later status changes require auth.
    match /publicStatuses/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'NEW';
      allow delete: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.status != 'DELIVERED' &&
        resource.data.status != 'CANCELLED';
    }
  }
}
