rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null && request.auth.uid == "f1Gx3tPIigZmqM2ImCzqGQN2xuJ3";
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /stock/{itemId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /users/{userId} {
      allow read: if isMaster() || (request.auth != null && request.auth.uid == userId);
      allow create: if isMaster() || (
        request.auth != null && request.auth.uid == userId
      );
      allow update: if isMaster() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.email == resource.data.email
      );
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.orderId is string &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.total is number &&
        request.resource.data.status == "NEW" &&
        (
          request.resource.data.userId == null ||
          (request.auth != null && request.resource.data.userId == request.auth.uid)
        );
      allow read: if isMaster() || (
        request.auth != null && resource.data.userId == request.auth.uid
      );
      allow update: if isMaster() || (
        request.auth != null && resource.data.deliveryBoyId == request.auth.uid
      );
      allow delete: if isMaster();
    }

    match /publicStatuses/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == "NEW";
      allow update: if isMaster() || (
        request.auth != null &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryBoyId == request.auth.uid
      );
      allow delete: if isMaster();
    }

    match /deliveryBoys/{deliveryBoyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isMaster();
    }

    match /deliveryAssignments/{orderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isMaster();
    }

    match /pushTokens/{tokenId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
