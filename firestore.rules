rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // STOCK
    // =========================
    match /stock/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }


    // =========================
    // CUSTOMER ACCOUNTS
    // =========================
    match /customers/{customerId} {
      allow read, create, update: if request.auth != null && request.auth.uid == customerId;
      allow delete: if request.auth != null && request.auth.uid == customerId;
    }

    // =========================
    // ORDERS
    // =========================
    match /orders/{orderId} {
      // Public customer checkout: create only a NEW order whose ID
      // matches the document ID and whose required fields have safe types.
      allow create: if
        request.resource.data.orderId == orderId &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.total is number &&
        request.resource.data.status == 'NEW' &&
        request.resource.data.customerId is string &&
        (request.auth != null ? request.resource.data.customerId == request.auth.uid : request.resource.data.customerId.matches('^local_[A-Za-z0-9_-]+$'));

      // Master/admin only for reading, editing and deleting orders.
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.status != 'DELIVERED' &&
        resource.data.status != 'CANCELLED';
    }


    // =========================
    // MASTER PUSH TOKENS
    // =========================
    match /masterPushTokens/{tokenId} {
      allow read: if false;
      allow create, update, delete: if request.auth != null;
    }

    // =========================
    // PUBLIC ORDER STATUS
    // =========================
    match /publicStatuses/{orderId} {
      // Customers can track status without signing in.
      allow read: if true;

      // Customer may create only the initial NEW status for the same order ID.
      allow create: if
        request.resource.data.orderId == orderId &&
        request.resource.data.status == 'NEW' && request.resource.data.customerId is string &&
        (request.auth != null ? request.resource.data.customerId == request.auth.uid : request.resource.data.customerId.matches('^local_[A-Za-z0-9_-]+$'));

      // Only authenticated Master/admin can change or delete status.
      allow update, delete: if request.auth != null;
    }

    // =========================
    // MENU
    // =========================
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // SETTINGS
    // =========================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
