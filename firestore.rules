rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // STOCK
    // =========================
    match /stock/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // ORDERS
    // =========================
    match /orders/{orderId} {
      // Public customer checkout: create only a NEW order whose ID
      // matches the document ID and whose required fields have safe types.
      allow create: if
        request.resource.data.orderId == orderId &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.total is number &&
        request.resource.data.status == 'NEW';

      // Master/admin only for reading, editing and deleting orders.
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.status != 'DELIVERED' &&
        resource.data.status != 'CANCELLED';
    }

    // =========================
    // PUBLIC ORDER STATUS
    // =========================
    match /publicStatuses/{orderId} {
      // Customers can track status without signing in.
      allow read: if true;

      // Customer may create only the initial NEW status for the same order ID.
      allow create: if
        request.resource.data.orderId == orderId &&
        request.resource.data.status == 'NEW';

      // Only authenticated Master/admin can change or delete status.
      allow update, delete: if request.auth != null;
    }

    // =========================
    // MENU
    // =========================
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // SETTINGS
    // =========================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
