rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function masterUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function ownsOrder(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid;
    }

    match /stock/{itemId} {
      allow read: if true;
      allow write: if masterUser();
    }

    match /customers/{customerId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == customerId;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.orderId == orderId
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.total is number
        && request.resource.data.status == 'NEW'
        && request.resource.data.customerId == request.auth.uid;

      allow read: if masterUser()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'phone'
          && request.auth.token.phone_number == '+91' + resource.data.phone);
      allow delete: if masterUser();

      allow update: if
        (
          signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['NEW', 'ACCEPTED']
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledBy', 'cancelledAt'])
        )
        ||
        (
          masterUser()
          && resource.data.status != 'DELIVERED'
          && resource.data.status != 'CANCELLED'
        );
    }

    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.orderId is string
        && request.resource.data.customerId == request.auth.uid
        && ownsOrder(request.resource.data.orderId);
      allow update, delete: if false;
    }

    match /masterPushTokens/{tokenId} {
      allow read: if false;
      allow create, update, delete: if masterUser();
    }

    match /publicStatuses/{orderId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'NEW'
        && request.resource.data.customerId == request.auth.uid;

      allow update: if
        (
          signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['NEW', 'ACCEPTED']
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledBy', 'updatedAt'])
        )
        || masterUser();

      allow delete: if masterUser();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if masterUser();
    }

    match /customerReviews/{orderId} {
      allow read, delete: if masterUser();
      allow update: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.keys().hasAll(['orderId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/publicStatuses/$(orderId))
        && get(/databases/$(database)/documents/publicStatuses/$(orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/publicStatuses/$(orderId)).data.status == 'DELIVERED'
        && (
          !exists(/databases/$(database)/documents/settings/reviews)
          || get(/databases/$(database)/documents/settings/reviews).data.feedbackEnabled != false
        );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if masterUser();
    }
  }
}
